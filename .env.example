APP_ENV=development
DATABASE_URL=postgresql+asyncpg://mali:mali@localhost:5432/mali_asistan
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=miniosecret
S3_BUCKET_NAME=documents

# ZORUNLU: en az 32 bayt. Uretmek icin:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=480
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Gorsel belge okuma: tesseract (varsayilan) veya ollama (yerel gorsel model;
# guclu GPU/bellek ister, zayif makinede sistemi kilitleyebilir).
VISION_BACKEND=tesseract
